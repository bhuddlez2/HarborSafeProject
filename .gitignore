# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Single consolidated .gitignore for the whole repo (website/frontend, portal/frontend,
# portal/backend). Per-app rules are grouped and path-prefixed below.

# --- Global: dependencies, OS files, logs, misc ---
node_modules/
.pnp
.pnp.*
.pnp.js
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.sqlite*

# --- Global: env files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
.env.production

# --- website/frontend (Next.js) ---
website/frontend/.yarn/*
!website/frontend/.yarn/patches
!website/frontend/.yarn/plugins
!website/frontend/.yarn/releases
!website/frontend/.yarn/versions
website/frontend/coverage/
website/frontend/.next/
website/frontend/out/
website/frontend/build/
website/frontend/.vercel
website/frontend/*.tsbuildinfo
website/frontend/next-env.d.ts

# --- portal/frontend (Next.js) ---
portal/frontend/.yarn/*
!portal/frontend/.yarn/patches
!portal/frontend/.yarn/plugins
!portal/frontend/.yarn/releases
!portal/frontend/.yarn/versions
portal/frontend/coverage/
portal/frontend/.next/
portal/frontend/out/
portal/frontend/build/
portal/frontend/.vercel
portal/frontend/*.tsbuildinfo
portal/frontend/next-env.d.ts

# --- portal/backend (Laravel) ---
portal/backend/.phpactor.json
portal/backend/.phpunit.result.cache
portal/backend/.fleet
portal/backend/.idea
portal/backend/.nova
portal/backend/.phpunit.cache
portal/backend/.vscode
portal/backend/.zed
portal/backend/auth.json
portal/backend/public/build
portal/backend/public/hot
portal/backend/public/storage
portal/backend/storage/*.key
portal/backend/storage/pail
portal/backend/vendor/
portal/backend/_ide_helper.php
portal/backend/Homestead.json
portal/backend/Homestead.yaml

# --- Build outputs (generic) ---
build/
dist/

# --- Playwright (root-level e2e) ---
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# extra files
file_org.txt
