# Copy to .env and adjust if your backend is not on the default port.
#
#   cp .env.example .env
#
# THE ORIGIN ONLY - NO TRAILING /api, NO TRAILING SLASH.
#
# Every call site appends its own path, e.g. app/lib/api.js does
# `${NEXT_PUBLIC_API_URL}/api/assessments`. So setting this to
# "http://localhost:8000/api" produces http://localhost:8000/api/api/assessments
# and the civilian assessment fails to submit with a 404 that reads as the API
# not being found. That exact mistake has already cost a debugging session.
#
# website/frontend uses the same variable with the same meaning.
NEXT_PUBLIC_API_URL=http://localhost:8000
